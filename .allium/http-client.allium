-- allium: 3
-- http-client.allium
--
-- Behaviour of the shared HTTP client (internal/client/client.go): auth
-- header selection, retry policy, error shaping, and credential scrubbing
-- of diagnostic output.

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- Shape of client.APIError (client.go:45-54). code is the numeric Alpaca
-- API error code parsed from the JSON error body; status is the HTTP
-- status (0 for transport failures).
value RequestError {
    status: Integer
    code: Integer?
    message: String
    method: String?
    path: String?
    request_id: String?
    hint: String?
    -- Parsed from the Retry-After header on 429 responses only
    -- (client.go:53, 285-291); zero/absent everywhere else.
    retry_after: Duration?
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum HttpMethod { get | post | put | patch | delete }

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- client.go:28 (maxRetries = 3): total send attempts, including the first
    max_attempts: Integer = 3
    -- client.go:189: base delay is 500ms, doubling per attempt
    backoff_base: Duration = 500.milliseconds
    -- client.go:97, 104; overridable per invocation with --timeout <seconds>
    -- (root.go:191-193)
    default_timeout: Duration = 30.seconds
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- client.Client (client.go:30-43). The four diagnostic flags are set on the
-- shared client from the persistent CLI flags before each command runs
-- (root.go:187-190).
entity HttpClient {
    api_key: String?
    secret: String?
    access_token: String?
    base_url: String
    data_url: String
    user_agent: String
    timeout: Duration
    verbose: Boolean
    debug: Boolean
    quiet: Boolean
    trace: Boolean
}

entity OutboundRequest {
    client: HttpClient
    method: HttpMethod
    path: String
    attempt: Integer
    status: in_flight | awaiting_retry | succeeded | failed
    error: RequestError when status = failed

    transitions status {
        in_flight -> awaiting_retry
        in_flight -> succeeded
        in_flight -> failed
        awaiting_retry -> in_flight
        terminal: succeeded, failed
    }
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- Generated typed client methods (internal/api/*_client.gen.go) and the raw
-- `alpaca api` passthrough all funnel through Client.Do / Client.DoWithHeaders
-- / doWithRetry (client.go:113-179). Operations with OAS header parameters
-- pass endpoint-specific headers, added to the request before the auth
-- headers (factory.go:89-106, client.go:213-217).
surface TypedClientMethods {
    provides:
        SendRequest(client, method, path, body?)
}

-- Stimuli from the Alpaca API server and the network.
surface UpstreamResponses {
    provides:
        ReceiveOkResponse(request)
        ReceiveRateLimitResponse(request, retry_after?)
        ReceiveServerErrorResponse(request, http_status)
        ReceiveNonRetryableErrorResponse(request, http_status)
        TransportFailure(request, cause)

    @guidance
        -- ReceiveOkResponse: any 2xx/3xx (status < 400, client.go:271).
        -- ReceiveRateLimitResponse: HTTP 429.
        -- ReceiveServerErrorResponse: exactly 500, 502, 503 or 504
        -- (client.go:181-183); 501 and every other 5xx are NOT retryable.
        -- ReceiveNonRetryableErrorResponse: any other status >= 400.
        -- TransportFailure: DNS/TCP/TLS/timeout errors where no HTTP
        -- response was received.
        -- Not modelled: failures that never reach an HTTP exchange or that
        -- occur while draining it — request body marshalling, request
        -- construction and response body read (client.go:199-211, 259-262).
        -- These return plain Go errors rather than APIError values, carry no
        -- status, hint or request id, and are never retried (client.go:165-168).
}

-- The process clock: the retry backoff timer firing.
surface RetryScheduler {
    provides:
        RetryDelayElapsed(request)
}

-- Verbose/debug/trace flags (and their ALPACA_VERBOSE / ALPACA_DEBUG /
-- ALPACA_TRACE env equivalents, root.go:153-161) route request/response
-- details to stderr.
surface DiagnosticOutput {
    provides:
        EmitDiagnosticOutput(content)
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule AuthWithAccessToken {
    when: SendRequest(client, method, path, body?)
    requires: client.access_token != null
    ensures: OutboundRequest.created(
        client: client,
        method: method,
        path: path,
        attempt: 1,
        status: in_flight
    )

    @guidance
        -- Access-token auth sends "Authorization: Bearer <token>" and takes
        -- priority over API key/secret when both are configured
        -- (client.go:218-219). Every request also carries
        -- "User-Agent: APCA-CLI/<version> <os>/<arch>" following the shared
        -- Alpaca SDK convention (useragent.Build, internal/useragent/
        -- useragent.go:13-15; client.go:103, 227) and
        -- "Content-Type: application/json" when a body is present
        -- (client.go:224-226).
}

rule AuthWithApiKeyAndSecret {
    when: SendRequest(client, method, path, body?)
    requires: client.access_token = null
    ensures: OutboundRequest.created(
        client: client,
        method: method,
        path: path,
        attempt: 1,
        status: in_flight
    )

    @guidance
        -- Key-pair auth sends the "APCA-API-KEY-ID" and
        -- "APCA-API-SECRET-KEY" headers (client.go:220-222). If neither
        -- credential is set the headers are sent empty; the server rejects
        -- with 401 — the client itself never blocks an unauthenticated send.
        -- The CLI layer normally stops earlier: commands needing auth run
        -- Resolved.Validate first (root.go:173-176, config.go:169-174), so an
        -- empty-header send is reachable only for callers bypassing that gate.
}

rule SucceedOnOkResponse {
    when: ReceiveOkResponse(request)
    requires: request.status = in_flight
    ensures: request.status = succeeded

    @guidance
        -- An empty 2xx body yields an empty result rather than a JSON parse
        -- error (client.go:295-297); the command layer renders it as {}
        -- (factory.go:113-123).
}

rule RetryOnRateLimitResponse {
    when: ReceiveRateLimitResponse(request, retry_after?)
    requires: request.status = in_flight
    requires: request.attempt < config.max_attempts
    ensures: request.status = awaiting_retry

    @guidance
        -- Wait for the delay in the Retry-After response header, parsed as
        -- integer seconds only (client.go:285-291); an absent or unparseable
        -- header falls back to the exponential backoff used for server
        -- errors (client.go:185-192).
        -- Unless --quiet, a "Rate limited, retrying in ..." notice goes to
        -- stderr; with --verbose every retry is announced (client.go:170-175).
}

rule RetryOnServerErrorResponse {
    when: ReceiveServerErrorResponse(request, _)
    requires: request.status = in_flight
    requires: request.attempt < config.max_attempts
    ensures: request.status = awaiting_retry

    @guidance
        -- Backoff before resend: backoff_base * 2^(attempt-1) plus uniform
        -- random jitter in [0, delay/2] (client.go:185-192). With the
        -- defaults: ~500ms, ~1s, ~2s (each +jitter).
}

rule ResumeAfterRetryDelay {
    when: RetryDelayElapsed(request)
    requires: request.status = awaiting_retry
    ensures:
        request.attempt = request.attempt + 1
        request.status = in_flight
}

-- Exhausting the retry budget surfaces the error parsed from the last
-- response, not a separate "retries exhausted" error (client.go:157-178:
-- lastErr is returned unchanged).
rule FailOnRateLimitMaxAttempts {
    when: ReceiveRateLimitResponse(request, _)
    requires: request.status = in_flight
    requires: request.attempt >= config.max_attempts
    ensures:
        request.status = failed
        request.error = parse_api_error(429)
}

rule FailOnServerErrorMaxAttempts {
    when: ReceiveServerErrorResponse(request, http_status)
    requires: request.status = in_flight
    requires: request.attempt >= config.max_attempts
    ensures:
        request.status = failed
        request.error = parse_api_error(http_status)
}

-- 4xx and non-retryable 5xx responses fail immediately, on any attempt.
rule FailOnNonRetryableErrorResponse {
    when: ReceiveNonRetryableErrorResponse(request, http_status)
    requires: request.status = in_flight
    ensures:
        request.status = failed
        request.error = parse_api_error(http_status)

    @guidance
        -- The error body is parsed as JSON into {code, message}
        -- (client.go:272-273); a non-JSON or message-less body falls back to
        -- the raw body text, then to the HTTP status text (client.go:273-278).
        -- request_id comes from the X-Request-Id response header
        -- (client.go:272).
        -- Default hints are attached by status: 401 invalid credentials,
        -- 403 forbidden, 422 validation, 429 rate limited (client.go:76-91).
        -- A 401 whose body is not JSON gets a "possible proxy or wrong URL"
        -- hint instead (client.go:279-284).
}

-- Network-level failures are never retried: only *APIError values with a
-- retryable status re-enter the loop, and transport errors carry status 0
-- (client.go:165-168, 181-183, 243-249).
rule FailOnTransportError {
    when: TransportFailure(request, cause)
    requires: request.status = in_flight
    ensures:
        request.status = failed
        request.error = transport_error(cause)

    @guidance
        -- The message is "could not reach <url>: <cause>" with credentials
        -- scrubbed from both URL and cause, plus a hint to check the internet
        -- connection and base URL and to run `alpaca doctor`
        -- (client.go:243-249, 310-332). status is 0 and code, request_id,
        -- method and path are all unset on this path.
}

rule ScrubCredentialsFromDiagnosticOutput {
    when: EmitDiagnosticOutput(content)
    ensures: DiagnosticEmitted(content: scrub_credentials(content))

    @guidance
        -- Every occurrence of the API key, secret and access token is
        -- replaced with "[REDACTED]" in --verbose request lines, --debug
        -- URLs, headers and response bodies, --trace output, and transport
        -- error messages (client.go:230-267, 302-332).
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant AttemptsNeverExceedMax {
    for r in OutboundRequests:
        r.attempt <= config.max_attempts
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "The --debug request BODY is printed without credential scrubbing (client.go:232-234), while the request URL, headers and response body are scrubbed. Credentials normally travel in headers, not bodies — is the unscrubbed body intentional or an oversight?"

open question "After the final failed retryable attempt, doWithRetry sleeps the full backoff delay once more before returning the error (client.go:156-178, sleep at 176 is unguarded by the loop bound) — ~2s plus jitter with the default backoff, or the whole Retry-After value on a 429. Intended?"

open question "HttpClient.verbose, .debug, .quiet, .trace and .user_agent exist on client.Client (client.go:37-41) and are referenced only in rule guidance, so no rule reads them; the checker reports them as unused fields. Should the diagnostic rules be conditioned on them explicitly, or do they stay descriptive?"
