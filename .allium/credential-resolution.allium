-- allium: 3
-- credential-resolution.allium
--
-- How `config.Load` (internal/config/config.go) resolves the credential
-- bundle, trading environment and base URLs for a CLI invocation.
--
-- Two independent resolutions happen per invocation:
--   1. Credentials resolve as an ATOMIC BUNDLE — the first complete source
--      wins and fields are never mixed across sources (config.go:21-23,
--      72-79, 107-129).
--   2. Paper-vs-live resolves separately from credentials
--      (config.go:80-88, 131-150).
--
-- `config.Load` also resolves the output format and colour mode in the same
-- pass (config.go:97-98); those are modelled in output-contract.allium and
-- deliberately left out here. Load's error return is vestigial: it is always
-- nil (config.go:104), so the error branch at root.go:169-171 is unreachable
-- and no rule below models a resolution failure.

use "./hand-authored-commands.allium" as commands

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- Contents of $ALPACA_CONFIG_DIR|~/.config/alpaca/config.yaml
-- (config.go:33-37, 190-201). Governed by the profile-management commands
-- in hand-authored-commands.allium.
external entity GlobalConfig {
    default_profile: String?
    output: String?
    color: String?
}

-- Process environment. An unset variable and an empty-string variable are
-- indistinguishable: the code tests os.Getenv(...) != "", so "" means absent
-- (config.go:110-111, 135). live_trade_override carries the RAW string value
-- of ALPACA_LIVE_TRADE — it is not a boolean. Only a trimmed,
-- case-insensitive "true" selects live (config.go:152-159); see the
-- Invariants section.
external entity EnvironmentConfig {
    api_key: String?
    secret_key: String?
    live_trade_override: String?
    profile: String?
    config_dir: String?
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum TradingEnvironment { paper | live }

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- config.go:91 (EnvPaper is the final fallback profile name)
    system_default_profile: String = "paper"
    paper_trading_url: String = "https://paper-api.alpaca.markets"
    live_trading_url: String = "https://api.alpaca.markets"
    market_data_url: String = "https://data.alpaca.markets"
}

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    env: EnvironmentConfig
    global_config: GlobalConfig
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity CredentialResolution {
    profile_name: String
    environment: TradingEnvironment
    kind: Unauthenticated | EnvironmentAPIKey | ProfileOAuth | ProfileAPIKey

    is_authenticated: kind != Unauthenticated
    is_oauth: kind = ProfileOAuth

    -- The resolved trading URL is a pure function of `environment`: Load
    -- only ever passes the "paper"/"live" aliases to ResolveBaseURL
    -- (config.go:137-149). ResolveBaseURL additionally accepts a full URL
    -- and returns it with trailing slashes trimmed (config.go:179-188), but
    -- no code path in Load reaches that branch, so a resolution never
    -- carries a custom trading URL.
    trading_url: if environment = live: config.live_trading_url else: config.paper_trading_url

    -- The market-data URL is a constant; nothing overrides it (config.go:96).
    data_url: config.market_data_url
}

variant Unauthenticated : CredentialResolution {}

variant EnvironmentAPIKey : CredentialResolution {
    api_key: String
    secret_key: String
}

variant ProfileOAuth : CredentialResolution {
    access_token: String
    scopes: String?
}

variant ProfileAPIKey : CredentialResolution {
    api_key: String
    secret_key: String
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- Resolution runs once per invocation from the root command's
-- PersistentPreRunE (internal/cmd/root.go:130-197), unless that hook returns
-- early first. Resolution and authentication are separate steps: Load always
-- runs (root.go:168), Validate runs only for auth-required commands
-- (root.go:173-176).
surface CommandStartup {
    provides:
        CredentialsRequested(requested_profile?)

    @guarantee StartupResolutionSkippedOnEarlyReturns
        -- PersistentPreRunE returns before reaching config.Load for four
        -- cases: the `help` command (root.go:131-133), `--help-all`
        -- (root.go:134-136), `--schema` (root.go:137-141) and any subcommand
        -- of `alpaca profile` (root.go:142-144). Cobra also skips the hook
        -- entirely for `--help` and for non-runnable commands such as bare
        -- `alpaca profile`. Everything else resolves, including the
        -- auth-exempt commands version, completion, update and doctor.

    @guarantee ProfileCommandsResolveOnDemandNotAtStartup
        -- `alpaca profile` subcommands skip STARTUP resolution only; they are
        -- not credential-free. `profile list` calls config.Load directly to
        -- mark the active profile (auth.go:286) and `profile login`/`switch`
        -- call it via loadOrCreateGlobal to preserve output and color
        -- settings (auth.go:98-102, 213-217, 319-323, 368-374). `doctor`
        -- re-resolves too (doctor.go:53). All of these call
        -- config.Load("", ""), so --profile does NOT reach them: `alpaca
        -- doctor --profile x` reports the default profile, not x (verified
        -- against the built binary). Only the startup resolution at
        -- root.go:168 honours the flag.

    @guarantee AuthRequiredCommandsValidate
        -- An Unauthenticated result aborts with "authentication required"
        -- and the hint to run `alpaca profile login` (root.go:173-176,
        -- config.go:169-174). The exemption list in needsAuth
        -- (root.go:232-242) matches only FIRST-LEVEL subcommands named
        -- version, help, completion, update or doctor, so it does not exempt
        -- the root command itself: `alpaca` with no arguments and
        -- `alpaca --version` both abort with "authentication required" when
        -- no credentials resolve (verified by running the built binary with
        -- an empty config dir). The env-shadow warning in the root RunE
        -- (root.go:115-126) is therefore only reachable when credentials
        -- already resolved.
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Profile name priority: explicit --profile flag > ALPACA_PROFILE >
-- global config default_profile > system default "paper" (config.go:91).
-- Empty string counts as absent at every level.
rule SelectProfileName {
    when: CredentialsRequested(requested_profile?)
    let profile_name =
        if requested_profile != null: requested_profile
        else if env.profile != null: env.profile
        else if global_config.default_profile != null: global_config.default_profile
        else: config.system_default_profile
    ensures: ProfileNameSelected(profile_name)

    @guidance
        -- The profile file is read from
        -- $ALPACA_CONFIG_DIR|~/.config/alpaca/profiles/<name>.yaml
        -- (config.go:64-70, 208-219). A missing OR unparseable profile file
        -- behaves identically to an empty profile: resolution falls through
        -- to the next source. Parse failures only print a warning on stderr
        -- (config.go:214-218); they never abort the command.
        --
        -- The selected name is interpolated into the path unsanitised
        -- (config.go:210), so it is not confined to the profiles directory:
        -- ALPACA_PROFILE=../../elsewhere/secret loads
        -- <config dir>/profiles/../../elsewhere/secret.yaml and resolves
        -- credentials from it (verified against the built binary). The same
        -- applies to --profile and to SaveProfile/DeleteProfile
        -- (config.go:233-247). No validation of the profile name exists
        -- anywhere in the resolution path.
}

-- Highest priority source: environment API key pair. Both fields are
-- required; a partial pair falls through to profile credentials rather than
-- partially authenticating (config.go:113-117).
rule ResolveFromEnvironmentAPIKeys {
    when: ProfileNameSelected(profile_name)
    requires: env.api_key != null and env.secret_key != null
    ensures: EnvironmentAPIKey.created(
        profile_name: profile_name,
        environment: if env_is_live(env.live_trade_override): live else: paper,
        api_key: env.api_key,
        secret_key: env.secret_key
    )

    @guidance
        -- When credentials come from the environment, the profile's
        -- live_trade field is never consulted (config.go:143-144 requires a
        -- profile-sourced credential bundle).
        --
        -- Shadowing is warned about, but only in three places: `profile
        -- login` after writing the profile (auth.go:109, 222), `doctor`
        -- (doctor.go:68) and the bare `alpaca` help screen
        -- (root.go:115-126). Ordinary commands print nothing when env keys
        -- override a stored profile. The warning also requires the profile
        -- to hold credentials of its own (auth.go:229-235); env keys with no
        -- stored profile are silent.
        --
        -- There is no environment variable for an OAuth access token. The
        -- environment source is API keys only, so an environment-sourced
        -- resolution is never is_oauth (config.go:109-128).
}

-- Profile credentials are stored as PLAINTEXT YAML at
-- <config dir>/profiles/<name>.yaml, file mode 0600, directory mode 0700
-- (config.go:233-243). No OS keyring, no encryption, no memory-only path:
-- `alpaca profile login` writes the OAuth access token (auth.go:90-96) and
-- the API secret key (auth.go:202-211) to disk in the clear, and the file
-- persists until `profile logout` removes it (config.go:245-247). The
-- scrubbing in the HTTP client (client.go:310-321) redacts these values from
-- --debug/--trace output only; it has no effect on what is stored.

-- Second priority: profile OAuth token. Used when no complete environment
-- API key pair is present (config.go:118-121).
rule ResolveFromProfileOAuth {
    when: ProfileNameSelected(profile_name)
    let profile = commands/Profile{name: profile_name}
    requires: (env.api_key = null or env.secret_key = null)
    requires: exists profile
    requires: profile.access_token != null
    ensures: ProfileOAuth.created(
        profile_name: profile_name,
        environment:
            if env.live_trade_override != null: (if env_is_live(env.live_trade_override): live else: paper)
            else if profile.live_trade = true: live
            else: paper,
        access_token: profile.access_token,
        scopes: profile.scopes
    )
}

-- Third priority: profile API key pair. Used when environment keys are
-- absent and the profile has no OAuth token (config.go:122-125).
rule ResolveFromProfileAPIKeys {
    when: ProfileNameSelected(profile_name)
    let profile = commands/Profile{name: profile_name}
    requires: (env.api_key = null or env.secret_key = null)
    requires: exists profile
    requires: profile.access_token = null
    requires: profile.api_key != null and profile.secret_key != null
    ensures: ProfileAPIKey.created(
        profile_name: profile_name,
        environment:
            if env.live_trade_override != null: (if env_is_live(env.live_trade_override): live else: paper)
            else if profile.live_trade = true: live
            else: paper,
        api_key: profile.api_key,
        secret_key: profile.secret_key
    )
}

-- Fallback: no complete credential bundle found in any source
-- (config.go:126-127). NOTE: the trading environment is still resolved from
-- ALPACA_LIVE_TRADE — base-URL resolution is independent of whether
-- credentials were found (config.go:134-150). An unauthenticated resolution
-- with ALPACA_LIVE_TRADE=true points at the live URL; requests then fail
-- with an auth error rather than being silently redirected to paper.
rule ResolveWithNoCredentials {
    when: ProfileNameSelected(profile_name)
    let profile = commands/Profile{name: profile_name}
    requires: (env.api_key = null or env.secret_key = null)
    requires:
        not exists profile
        or (profile.access_token = null and (profile.api_key = null or profile.secret_key = null))
    ensures: Unauthenticated.created(
        profile_name: profile_name,
        environment: if env_is_live(env.live_trade_override): live else: paper
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- env_is_live(v) is deliberately strict: only trimmed, case-insensitive
-- "true" selects live. Any other set value — "1", "yes", "false", a typo —
-- forces paper (config.go:152-159). When the variable is set at all, the
-- profile's live_trade field is ignored entirely (config.go:135-142).

-- The unsafe path always requires explicit opt-in: live is selected only by
-- ALPACA_LIVE_TRADE=true, or by profile.live_trade=true when the credential
-- bundle came from that profile and ALPACA_LIVE_TRADE is unset or empty.
--
-- The `profile.live_trade = true` half of that sentence is NOT expressible
-- here. A resolution does not retain the profile it came from: Resolved
-- holds only the winning credential values, the profile NAME and the source
-- tag (config.go:51-62). The invariant below therefore asserts the
-- structural half — live requires either the env var or a profile-sourced
-- bundle with the env var unset — and leaves the live_trade field check to
-- the rules and to the tests at profile_test.go:238-377.
invariant LiveRequiresExplicitOptIn {
    for r in CredentialResolutions:
        r.environment = live implies
            (env_is_live(env.live_trade_override)
             or ((r.kind = ProfileOAuth or r.kind = ProfileAPIKey)
                 and env.live_trade_override = null))
}

-- Neither environment-sourced nor absent credentials can inherit a profile's
-- live_trade, because config.go:143-144 gates that branch on the source tag.
-- For those two kinds, live requires ALPACA_LIVE_TRADE to parse as live: any
-- other set value ("1", "yes", "false", a typo) still yields paper.
invariant NonProfileCredentialsIgnoreProfileLiveTrade {
    for r in CredentialResolutions:
        ((r.kind = EnvironmentAPIKey or r.kind = Unauthenticated)
         and not env_is_live(env.live_trade_override))
            implies r.environment = paper
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Unauthenticated + ALPACA_LIVE_TRADE=true resolves the live base URL (config.go:134-150). Auth-required commands abort before any request, but is pointing an unauthenticated invocation at the live URL intended, or should the paper default apply when no credentials resolve?"

open question "needsAuth (root.go:232-242) only exempts first-level subcommands, so the root command is auth-required: with no credentials, bare `alpaca` and `alpaca --version` exit 1 with 'authentication required' instead of printing help or the version (verified against the built binary). `alpaca --help`, `alpaca help` and `alpaca version` still work. Is the root command's auth requirement intended, or should needsAuth exempt the root command too?"

open question "Profile names are not validated before being used as a path fragment (config.go:210), so `--profile ../../x` or ALPACA_PROFILE=../../x reads a credential file outside the profiles directory. Should profile names be constrained to a safe character set, or is the traversal acceptable given the name is always supplied by the invoking user?"

open question "Profile credentials, including OAuth access tokens and API secret keys, are written to disk as plaintext YAML (config.go:233-243). No OS keyring integration exists. Is plaintext-at-0600 the accepted posture, or is keyring storage intended?"
