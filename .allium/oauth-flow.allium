-- allium: 3
-- oauth-flow.allium
-- Authorization-code OAuth2 flow for CLI user authentication
-- (internal/oauth/oauth.go, internal/oauth/config.go).
-- Currently restricted to paper trading; live trading requires API keys
-- until PKCE is added (internal/cmd/auth.go:48-51).

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- Shape of the token endpoint response (oauth.go:25-29).
-- Only access_token and scope are carried forward by the caller;
-- token_type is parsed and then discarded, and the Authorization header
-- is built as a literal "Bearer " prefix (internal/cmd/auth.go:84, 91-92).
-- The response carries no refresh token and no expiry: the implementation
-- has no field, storage or code path for either (verified by search across
-- the Go sources).
value AccessToken {
    access_token: String
    token_type: String
    scope: String
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity AuthorizationRequest {
    scope: String
    environment: String
    state: String
    redirect_uri: String
    initiated_at: Timestamp
    -- `denied` covers the three ways the callback itself fails: an `error`
    -- query parameter, a state mismatch and a missing code (oauth.go:87-111).
    -- The implementation has no state machine of its own -- Login is a linear
    -- function that returns a token or an error (oauth.go:36-78) -- so these
    -- states model the distinct terminal outcomes, not stored values.
    status: pending | completed | denied | exchange_failed | timed_out

    transitions status {
        pending -> completed
        pending -> denied
        pending -> exchange_failed
        pending -> timed_out
        terminal: completed, denied, exchange_failed, timed_out
    }

    token: AccessToken when status = completed
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

-- None of these are configurable at runtime: they are Go constants and
-- literals (oauth/config.go:3-12, oauth.go:75, 135). The config block records
-- the values, not a settings mechanism.
config {
    -- oauth.go:75 (2-minute wait for the browser callback)
    authorization_timeout: Duration = 2.minutes
    -- oauth.go:135 (HTTP client timeout for the token exchange)
    token_exchange_timeout: Duration = 15.seconds
    authorize_url: String = "https://app.alpaca.markets/oauth/authorize"
    token_url: String = "https://api.alpaca.markets/oauth/token"
    -- oauth/config.go:7 (used when the user selects no scopes explicitly)
    default_scopes: String = "account:write trading data"
    -- internal/cmd/auth.go:62 with config.EnvPaper (internal/config/config.go:14);
    -- the OAuth path has no other environment, see @guarantee PaperOnly
    environment: String = "paper"
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- `alpaca profile login` (OAuth path) drives the flow
-- (internal/cmd/auth.go:48-111).
surface ProfileLoginCommand {
    provides:
        UserInitiatesAuthorization(scope?)

    @guarantee PaperOnly
        -- The OAuth path never targets live trading: `--live` is rejected
        -- before any state is generated or any port is bound, with a hint to
        -- use API keys instead (internal/cmd/auth.go:49-51). The environment
        -- carried into the authorization URL is always the paper environment
        -- (internal/cmd/auth.go:62); the caller cannot choose it.

    @guidance
        -- The `scope` parameter is optional at this boundary and is resolved
        -- in three branches (internal/cmd/auth.go:64-75): an explicit
        -- `--scope` flag (commas replaced by spaces); otherwise, when stdin
        -- is a terminal, an interactive multi-select pre-ticked with all of
        -- account:write, trading and data (auth.go:118-145) — cancelling it
        -- aborts the login before any browser interaction, and selecting
        -- nothing falls back to the defaults; otherwise config.default_scopes.
}

-- The localhost callback endpoint the browser is redirected to
-- (oauth.go:85-117).
surface BrowserCallback {
    provides:
        AuthorizationCodeReceived(request, code, state)
        AuthorizationCallbackError(request, reason)

    @guarantee CallbackPortsFixed
        -- The callback server binds 127.0.0.1 on the first free port of the
        -- pre-registered set 41920-41924 (oauth/config.go:12,
        -- oauth.go:186-195); the redirect URI is
        -- http://localhost:<port>/callback (oauth.go:46).

    @guarantee NoPortNoFlow
        -- If none of the callback ports can be bound, login fails before any
        -- browser interaction, with a hint to free a port or close other
        -- `alpaca profile login` instances (oauth.go:186-195).
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule UserInitiatesAuthorization {
    when: UserInitiatesAuthorization(scope?)
    ensures: AuthorizationRequest.created(
        scope: resolved_scopes(scope),
        environment: config.environment,
        state: random_state(),
        redirect_uri: callback_redirect_uri(),
        initiated_at: now,
        status: pending
    )

    @guidance
        -- resolved_scopes is the three-branch resolution described on the
        -- ProfileLoginCommand surface (internal/cmd/auth.go:64-75); no single
        -- expression captures it, because the middle branch is an interactive
        -- prompt. It always yields a non-empty scope string, so the
        -- "scope when non-empty" branch of the URL builder is unreachable
        -- from this call site (the only caller of Login is auth.go:77).
        -- random_state() is 16 bytes from a cryptographic RNG, hex-encoded
        -- (oauth.go:178-184); it is embedded as the `state` query parameter
        -- of the authorization URL so the callback can be CSRF-validated.
        -- The authorization URL carries response_type=code, client_id,
        -- redirect_uri, state, plus scope and env when non-empty
        -- (oauth.go:162-176).
        -- The browser is opened via the platform opener (open/xdg-open/
        -- rundll32); if that fails, the URL is printed for manual use and
        -- the flow keeps waiting (oauth.go:62-66, 197-208).
}

rule AuthorizationCodeExchanged {
    when: AuthorizationCodeReceived(request, code, state)
    requires: request.status = pending
    requires: state = request.state
    requires: code != ""
    ensures:
        let token = exchange_code(code, request.redirect_uri)
        if token != null:
            request.status = completed
            request.token = token
        else:
            request.status = exchange_failed

    @guidance
        -- exchange_code POSTs grant_type=authorization_code, the code, the
        -- CLI's embedded first-party client_id/client_secret and the exact
        -- redirect URI to the token endpoint as a form body, with the CLI
        -- user agent (oauth.go:119-135, oauth/config.go:34-35).
        -- A transport error, a non-200 token response, an unreadable or
        -- unparseable body, or an empty access_token in the response each
        -- fail the login (oauth.go:130-157) — the request does NOT reach
        -- completed in those cases, which is the exchange_failed branch.
        -- The "token exchange failed" wording covers request construction
        -- (oauth.go:130), transport failure (137) and non-200 (147); the
        -- body failures report "reading token response" (143) and
        -- "parsing token response" (153), and the empty-token case reports
        -- "token exchange returned empty access token" (156).
        -- Reaching completed is not the end of the command: unless
        -- --no-validate is passed, the access token is checked with a
        -- GET /v2/account bearer request against the paper base URL, and a
        -- 401/403 (or any >=400) aborts the login without storing anything
        -- (internal/cmd/auth.go:82-88, 347-366). This spec does not model
        -- credential storage; see credential-resolution.allium.
}

-- A callback state that does not exactly match the value generated at
-- initiation is rejected as a potential CSRF attack: the browser gets
-- HTTP 400 and the CLI fails with "state mismatch" (oauth.go:101-105).
rule AuthorizationStateMismatch {
    when: AuthorizationCodeReceived(request, code, state)
    requires: request.status = pending
    requires: state != request.state
    ensures: request.status = denied
}

-- A callback with a matching state but no authorization code fails with
-- "no authorization code received" (oauth.go:107-111).
rule AuthorizationMissingCode {
    when: AuthorizationCodeReceived(request, code, state)
    requires: request.status = pending
    requires: state = request.state
    requires: code = ""
    ensures: request.status = denied
}

rule AuthorizationDenied {
    when: AuthorizationCallbackError(request, reason)
    requires: request.status = pending
    ensures: request.status = denied

    @guidance
        -- Fires when the callback carries an `error` query parameter; the
        -- error_description (or the error code when absent) is shown to the
        -- user and rendered on the browser error page (oauth.go:87-96).
        -- The browser page is static HTML; the description is HTML-escaped
        -- (oauth.go:221-233), and it is returned with HTTP 200 unlike the
        -- state-mismatch and missing-code paths, which return HTTP 400.
        -- This branch is taken before the state parameter is compared
        -- (oauth.go:87 precedes oauth.go:101), so an error callback is NOT
        -- CSRF-validated: hence no state requirement on this rule.
}

rule AuthorizationTimedOut {
    when: request: AuthorizationRequest.initiated_at + config.authorization_timeout <= now
    requires: request.status = pending
    ensures: request.status = timed_out

    @guidance
        -- The user sees "timed out waiting for authorization" with a hint to
        -- complete the browser flow (oauth.go:75-77).
        -- The race between a callback arriving and the timeout firing is
        -- real and resolved first-event-wins by the select loop
        -- (oauth.go:69-77): every transition out of pending is terminal, so
        -- the losing event has no effect. A callback that arrives after the
        -- timeout is written to the buffered channel and never read; the
        -- server is then shut down with a 2-second grace period
        -- (oauth.go:48, 54-58).
        -- The timeout is hardcoded as 2*time.Minute at the select and
        -- repeated as literal text in the "Waiting for authorization"
        -- message (oauth.go:67, 75); config.authorization_timeout models
        -- both, but nothing in the implementation is configurable.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "PKCE — when will PKCE or Device Authorization Grant (RFC 8628) be added to enable live trading authorization?"

open question "Token lifetime is unmodelled because the implementation has none: the token response carries no expiry and no refresh token, the stored access token is used indefinitely, and `alpaca profile logout` only deletes the local profile file (internal/config/config.go:245-247) without revoking at the provider. Is indefinite local validity intended, and who is expected to revoke?"

open question "The callback channel is first-writer-wins with capacity 1 (oauth.go:48); after a rejected callback (state mismatch / missing code) the flow fails immediately rather than continuing to wait for a legitimate callback. Is fail-fast the intended CSRF response, or should the server keep listening until the timeout?"
